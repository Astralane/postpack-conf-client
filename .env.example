# Copy to .env and fill in. Variables already set in the environment take precedence.

PRECONF_ENDPOINT=http://127.0.0.1:12349
PRECONF_TOKEN=

# Comma separated base58 pubkeys, quoted if the list has spaces. A transaction is sent
# when it matches either list. Accounts match only when the transaction can write them;
# program ids belong in PRECONF_PROGRAMS, which matches in any account position.
# A post-pack relay sends nothing when both are empty.
PRECONF_ACCOUNTS=
PRECONF_PROGRAMS=11111111111111111111111111111111

# Logs go to the console and to a file in this directory that rolls over daily.
PRECONF_LOG_DIR=logs
# debug adds every transaction and slot boundary to the 15 second counts
RUST_LOG=info
